// ==================== API 访问与异常日志 ====================

model InfraApiAccessLog {
  id              Int      @id @default(autoincrement())
  traceId         String?  @map("trace_id") @db.VarChar(64)
  userId          Int?     @map("user_id")
  userType        Int      @default(2) @map("user_type") // 1=会员, 2=管理员
  applicationName String   @default("bold-bose-server") @map("application_name") @db.VarChar(50)
  requestMethod   String   @map("request_method") @db.VarChar(16)
  requestUrl      String   @map("request_url") @db.VarChar(500)
  requestParams   String?  @map("request_params") @db.Text
  responseBody    String?  @map("response_body") @db.Text
  userIp          String   @map("user_ip") @db.VarChar(50)
  userAgent       String   @default("") @map("user_agent") @db.VarChar(512)
  beginTime       DateTime @map("begin_time")
  endTime         DateTime @map("end_time")
  duration        Int
  resultCode      Int      @default(200) @map("result_code")
  resultMsg       String?  @map("result_msg") @db.VarChar(500)
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([beginTime])
  @@index([userId, userType])
  @@index([requestUrl])
  @@map("infra_api_access_logs")
}

model InfraApiErrorLog {
  id                  Int       @id @default(autoincrement())
  traceId             String?   @map("trace_id") @db.VarChar(64)
  userId              Int?      @map("user_id")
  userType            Int       @default(2) @map("user_type")
  applicationName     String    @default("bold-bose-server") @map("application_name") @db.VarChar(50)
  requestMethod       String    @map("request_method") @db.VarChar(16)
  requestUrl          String    @map("request_url") @db.VarChar(500)
  requestParams       String?   @map("request_params") @db.Text
  userIp              String    @map("user_ip") @db.VarChar(50)
  userAgent           String    @default("") @map("user_agent") @db.VarChar(512)
  exceptionTime       DateTime  @default(now()) @map("exception_time")
  exceptionName       String    @map("exception_name") @db.VarChar(128)
  exceptionMessage    String    @map("exception_message") @db.Text
  exceptionStackTrace String?   @map("exception_stack_trace") @db.Text
  processStatus       Int       @default(0) @map("process_status") // 0=未处理, 1=已处理, 2=已忽略
  processTime         DateTime? @map("process_time")
  processUserId       Int?      @map("process_user_id")
  createdAt           DateTime  @default(now()) @map("created_at")

  @@index([exceptionTime])
  @@index([processStatus])
  @@map("infra_api_error_logs")
}



